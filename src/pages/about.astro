---
import PageLayout from '../layouts/PageLayout.astro';
import { EXPERIENCES } from '../utils/constants';

const certifications = [
  'Agentic AI Architecture Foundations: Designing Autonomous AI Systems',
  'Agentic AI Solution Design Patterns',
  'Agentic AI Solution Communication Architectures',
  'Cloud-Based Agentic AI Design Patterns',
  'Generative AI and Predictive AI in the Cloud',
];

const techStack = [
  { name: 'Angular', years: '8+' },
  { name: 'TypeScript', years: '8+' },
  { name: 'Electron', years: '3.5' },
  { name: 'RxJS', years: '8+' },
  { name: 'AI Workflows', years: '2+' },
  { name: 'Prompt Engineering', years: '2+' },
  { name: 'React', years: '1' },
  { name: 'Node.js', years: '4' },
  { name: 'PouchDB', years: '3.5' },
  { name: 'gRPC / Protobuf', years: '3.5' },
  { name: 'WebRTC', years: '3.5' },
  { name: 'MongoDB', years: '2' },
  { name: 'Docker', years: '2' },
  { name: 'SCSS/CSS', years: '8+' },
];

const differentiators = [
  {
    title: 'AI ile Çarpıcı Biçimde Hızlanıyorum',
    description: 'AI araçlarını günlük geliştirme süreçlerime derinlemesine entegre ediyorum. Kod üretimi, debug, test, dokümantasyon ve mimari kararlarda AI ile 10x verimlilik.',
  },
  {
    title: 'Sadece Kod Yazmıyorum, Ürün İnşa Ediyorum',
    description: 'Yıllardır aynı ürünün evrimini yönetiyorum. Feature geliştirmenin ötesinde sistem düşünce yapısı, mimari kararlar ve uzun vadeli sürdürülebilirlik.',
  },
  {
    title: 'Karmaşıklığı Yönetebiliyorum',
    description: 'Mega refactor, sıfırdan modül inşası, authentication entegrasyonu — karmaşık sistemleri parçalara ayırıp sistematik olarak teslim ediyorum.',
  },
  {
    title: 'Performansı Ölçüyorum, Tahmin Etmiyorum',
    description: 'Memory leak tespiti, render optimizasyonu, virtual scroll bugları ve race condition çözümleri. Kullanıcılar hızlı ve stabil bir ürünü hemen hisseder.',
  },
  {
    title: 'Legacy Kodu Modernleştiriyorum',
    description: 'Birden fazla major Angular migration, 100+ bağımlılık güncelleme, Material Legacy → MDC geçişi. Projeyi yaşlandıkça çürümekten koruyan sistematik modernizasyon.',
  },
  {
    title: 'Öğrenmeyi Öğretiyorum',
    description: 'AI çağında en önemli beceri: kendi öğrenme yolculuğunu tasarlamak. Neyi öğrenmen gerektiğini tespit etme, AI ile müfredat oluşturma ve pratik odaklı öğrenme stratejileri.',
  },
];
---

<PageLayout
  title="Hakkımda"
  description="Umut Çakır — AI-Augmented Software Engineer. Derin mühendislik deneyimini AI ile birleştirerek karmaşık ürünler inşa eden, ekipleri hızlandıran mühendis."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Page title -->
    <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-surface-50 mb-8">
      Hakkımda
    </h1>

    <!-- Philosophy — client-focused -->
    <section class="mb-16">
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <p>
          <strong>Yazılım mühendisliği sadece kod yazmak değil</strong> — doğru problemi anlamak, doğru sistemi 
          tasarlamak, doğru trade-off'ları yapmak ve ürünü büyürken stabil tutmak. Bu yaklaşımla 9+ yıldır 
          production ürünler geliştiriyorum.
        </p>
        <p>
          Şu an <strong>güvenlik odaklı bir enterprise iletişim platformunda</strong> çalışıyorum.
          Mesajlaşma UX'i, feed sistemleri, OpenID authentication, çoklu cihaz senkronizasyonu, 
          offline-first veri yönetimi ve performans iyileştirmeleri gibi karmaşık sorunları çözüyorum.
          İşimi seviyorum ve ekibime değer katmaktan mutluluk duyuyorum.
        </p>
        <p>
          Daha önce <strong>ADYOUNEED'i teknik kurucu olarak sıfırdan kurdum</strong>: ekip oluşturma, 
          mimari tasarım, frontend, backend, ödeme entegrasyonu ve deployment — 0'dan 1'e tam yığın 
          ürün geliştirme deneyimi.
        </p>
        <p>
          Öğrendiklerimi bu blog üzerinden paylaşıyorum. Angular migration, performans mühendisliği,
          Electron ve mimari konularında <strong>teknik danışmanlık</strong> da veriyorum. Ayrıca
          deneyimlerimi yapılandırılmış <strong>dijital ürünler</strong> (rehberler, checklist'ler)
          olarak sunmaya başlıyorum.
        </p>
      </div>
    </section>

    <!-- What makes me different -->
    <section class="mb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-6">
        Neden Ben
      </h2>
      <div class="space-y-4">
        {differentiators.map(d => (
          <div class="p-4 rounded-xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700">
            <h3 class="text-sm font-bold text-surface-900 dark:text-surface-50 mb-1">{d.title}</h3>
            <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed">{d.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="mb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-6">
        Teknoloji Yığını
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {techStack.map(tech => (
          <div class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700">
            <span class="text-sm font-medium text-surface-900 dark:text-surface-100">{tech.name}</span>
            <span class="text-xs text-surface-500 dark:text-surface-400">{tech.years} yıl</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-6">
        Sertifikalar
      </h2>
      <ul class="space-y-3">
        {certifications.map(cert => (
          <li class="flex items-start gap-3 text-sm text-surface-700 dark:text-surface-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 text-primary-500"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            {cert}
          </li>
        ))}
      </ul>
    </section>

    <!-- Languages -->
    <section class="mb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-6">
        Diller
      </h2>
      <div class="flex gap-4">
        <div class="px-4 py-3 rounded-xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700">
          <div class="text-sm font-medium text-surface-900 dark:text-surface-100">Türkçe</div>
          <div class="text-xs text-surface-500 dark:text-surface-400">Anadil</div>
        </div>
        <div class="px-4 py-3 rounded-xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700">
          <div class="text-sm font-medium text-surface-900 dark:text-surface-100">İngilizce</div>
          <div class="text-xs text-surface-500 dark:text-surface-400">Profesyonel</div>
        </div>
      </div>
    </section>

    <!-- Career Timeline -->
    <section class="mb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-6">
        Kariyer
      </h2>
      <div class="relative">
        <div class="absolute left-4 top-0 bottom-0 w-px bg-surface-200 dark:bg-surface-700"></div>
        {EXPERIENCES.map(exp => (
          <div class="relative pl-12 pb-10 last:pb-0">
            <div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full border-2 border-primary-500 bg-surface-50 dark:bg-surface-900"></div>
            <span class="text-xs font-medium text-primary-600 dark:text-primary-400 uppercase tracking-wide">{exp.period}</span>
            <h3 class="text-base font-bold text-surface-900 dark:text-surface-50 mt-1">{exp.company}</h3>
            <p class="text-sm text-surface-600 dark:text-surface-400">{exp.role} · {exp.location}</p>
            <p class="text-sm text-surface-600 dark:text-surface-400 mt-2 leading-relaxed">{exp.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center p-8 rounded-2xl bg-primary-50 dark:bg-primary-900/10 border border-primary-100 dark:border-primary-900/30">
      <h2 class="text-lg font-bold text-surface-900 dark:text-surface-50 mb-2">
        AI ile daha etkili çalışmak ister misiniz?
      </h2>
      <p class="text-sm text-surface-600 dark:text-surface-400 mb-4">
        AI-augmented geliştirme, öğrenme stratejileri ve teknik danışmanlık hakkında iletişime geçin.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-medium transition-colors shadow-lg shadow-primary-600/20"
        >
          Blog Yazıları
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 font-medium transition-colors"
        >
          İletişime Geçin
        </a>
      </div>
    </section>
  </div>
</PageLayout>

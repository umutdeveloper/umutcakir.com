---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique tags
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags))].sort();
---

<PageLayout
  title="Blog"
  description="AI ile yazılım geliştirme, verimlilik stratejileri ve mühendislik deneyimleri hakkında yazılar."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-surface-50 mb-4">
        Blog
      </h1>
      <p class="text-lg text-surface-600 dark:text-surface-400">
        AI ile daha etkili geliştirme, verimlilik stratejileri ve gerçek dünya mühendislik deneyimleri hakkında yazıyorum.
      </p>
    </div>

    <!-- Tags -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-10">
        {allTags.map(tag => (
          <span class="px-3 py-1.5 text-xs font-medium rounded-full border border-surface-200 dark:border-surface-700 text-surface-600 dark:text-surface-400 bg-white dark:bg-surface-800">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Posts grid -->
    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id.replace(/\.mdx?$/, '')}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-surface-500 dark:text-surface-400">Henüz yazı yok. Yakında burada olacak!</p>
      </div>
    )}
  </div>
</PageLayout>

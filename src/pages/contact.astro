---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../utils/constants';

const scenarios = [
  {
    icon: '🤖',
    title: 'AI-Augmented Geliştirme Danışmanlığı',
    description: 'Ekibinizin AI araçlarını etkili kullanması, AI-augmented geliştirme stratejisi ve verimlilik artışı konularında danışmanlık.',
  },
  {
    icon: '✍️',
    title: 'Blog & İçerik',
    description: 'AI ile verimlilik, öğrenme stratejileri ve mühendislik pratikleri hakkında yazılarım üzerine geri bildirim veya iş birliği.',
  },
  {
    icon: '📦',
    title: 'Eğitim & Dijital Ürünler',
    description: 'AI ile kendi öğrenme yolculuğunuzu tasarlama, AI-augmented geliştirme eğitimleri ve teknik kaynaklar.',
  },
];
---

<PageLayout
  title="İletişim"
  description="Umut Çakır ile iletişime geçin. AI-augmented geliştirme danışmanlığı, eğitim ve iş birlikleri hakkında."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-surface-900 dark:text-[#EDEDEC] mb-4">
      İletişim
    </h1>
    <div class="h-px w-16 bg-accent-400/40 mb-4"></div>
    <p class="text-lg text-surface-500 dark:text-surface-400 mb-12">
      AI-augmented geliştirme, öğrenme stratejileri veya teknik iş birliği hakkında konuşmak için bana ulaşın.
    </p>

    <!-- Scenarios -->
    <section class="mb-12">
      <h2 class="section-label mb-6">
        Size Nasıl Yardımcı Olabilirim
      </h2>
      <div class="grid gap-4">
        {scenarios.map(s => (
          <div class="flex items-start gap-4 p-4 card-blueprint">
            <span class="text-2xl">{s.icon}</span>
            <div>
              <h3 class="font-display text-sm font-bold text-surface-900 dark:text-[#EDEDEC]">{s.title}</h3>
              <p class="text-sm text-surface-500 dark:text-surface-400">{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact methods -->
    <section>
      <h2 class="section-label mb-6">
        İletişim Kanalları
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
      <!-- Email -->
      <a
        href={`mailto:${SITE.email}`}
        class="flex items-start gap-4 p-6 card-glass group"
      >
        <div class="w-10 h-10 rounded-lg bg-accent-400/10 text-accent-500 dark:text-accent-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <div>
          <div class="font-display font-semibold text-surface-900 dark:text-[#EDEDEC] mb-1">E-posta</div>
          <div class="text-sm text-surface-500 dark:text-surface-400">{SITE.email}</div>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start gap-4 p-6 card-glass group"
      >
        <div class="w-10 h-10 rounded-lg bg-accent-400/10 text-accent-500 dark:text-accent-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <div>
          <div class="font-display font-semibold text-surface-900 dark:text-[#EDEDEC] mb-1">LinkedIn</div>
          <div class="text-sm text-surface-500 dark:text-surface-400">linkedin.com/in/umuttcakir</div>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start gap-4 p-6 card-glass group"
      >
        <div class="w-10 h-10 rounded-lg bg-accent-400/10 text-accent-500 dark:text-accent-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </div>
        <div>
          <div class="font-display font-semibold text-surface-900 dark:text-[#EDEDEC] mb-1">GitHub</div>
          <div class="text-sm text-surface-500 dark:text-surface-400">github.com/umutcakir</div>
        </div>
      </a>

      <!-- Phone -->
      <a
        href={`tel:${SITE.phone}`}
        class="flex items-start gap-4 p-6 card-glass group"
      >
        <div class="w-10 h-10 rounded-lg bg-accent-400/10 text-accent-500 dark:text-accent-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div>
          <div class="font-display font-semibold text-surface-900 dark:text-[#EDEDEC] mb-1">Telefon</div>
          <div class="text-sm text-surface-500 dark:text-surface-400">{SITE.phone}</div>
        </div>
      </a>
    </div>
  </div>
</PageLayout>

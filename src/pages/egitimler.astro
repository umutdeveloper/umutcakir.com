---
import PageLayout from '../layouts/PageLayout.astro';
import { TEACHINGS, PAST_TEACHINGS } from '../utils/constants';
---

<PageLayout
  title="Eğitimler — Umut Çakır"
  description="AI ile öğrenme stratejileri, AI-augmented yazılım geliştirme ve geçmiş teknik eğitim materyalleri."
>
  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="section-label mb-4 inline-block">
          Eğitim & AI-Augmented Öğrenme
        </span>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-surface-900 dark:text-[#EDEDEC] mb-4">
          AI Çağında Öğrenme ve Geliştirme
        </h1>
        <div class="h-px w-16 bg-accent-400/40 mb-4"></div>
        <p class="text-lg text-surface-500 dark:text-surface-400 leading-relaxed">
          AI artık her konuyu öğretebiliyor &#8212; asıl mesele <strong class="text-surface-800 dark:text-surface-200">neyi öğrenmen gerektiğini bilmek</strong>,
          <strong class="text-surface-800 dark:text-surface-200">kendi öğrenme yolculuğunu tasarlamak</strong> ve
          <strong class="text-surface-800 dark:text-surface-200">AI araçlarıyla 10x verimli olmak</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="section-divider mb-16"><span>◆</span></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-label mb-3 text-center">
        Odak Alanlarım
      </h2>
      <p class="text-lg text-surface-500 dark:text-surface-400 max-w-2xl mx-auto text-center mb-10">
        AI ile daha hızlı öğren, daha etkili geliştir
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {TEACHINGS.map((teaching, i) => (
          <div class="card-glass p-6 sm:p-8 flex flex-col group">
            <div class="mb-4">
              <div class="w-10 h-10 rounded-lg bg-teal-400/10 text-teal-500 dark:text-teal-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
              </div>
              <h3 class="font-display text-xl font-bold text-surface-900 dark:text-[#EDEDEC]">
                {teaching.title}
              </h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-md bg-accent-400/10 text-accent-500 dark:text-accent-400 font-mono">
                  {teaching.platform}
                </span>
              </div>
            </div>

            <p class="text-sm text-surface-500 dark:text-surface-400 leading-relaxed mb-4">
              {teaching.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mt-auto">
              {teaching.topics.map((topic: string) => (
                <span class="badge-tech">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="section-divider mb-16"><span>◆</span></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="section-label mb-3">
          Geçmiş Eğitimler
        </h2>
        <p class="text-base text-surface-500 dark:text-surface-400 max-w-2xl mx-auto">
          2023'te çevrimiçi eğitim platformunda verdiğim teknik eğitimler ve materyalleri
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {PAST_TEACHINGS.map((teaching) => (
          <div class="p-6 card-glass flex flex-col">
            <h3 class="font-display text-base font-semibold text-surface-900 dark:text-[#EDEDEC] mb-1">
              {teaching.title}
            </h3>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-surface-400 font-mono">
                {teaching.platform}
              </span>
              <span class="text-surface-300 dark:text-surface-600">&middot;</span>
              <span class="text-xs text-surface-400 font-mono">
                {teaching.period}
              </span>
            </div>
            <p class="text-sm text-surface-500 dark:text-surface-400 leading-relaxed mb-4">
              {teaching.description}
            </p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {teaching.resources.slides && (
                <a
                  href={teaching.resources.slides}
                  target="_blank"
                  class="text-link inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium badge-tech hover:border-accent-300 hover:text-accent-600 dark:hover:text-accent-400"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>
                  Sunum
                </a>
              )}
              {teaching.resources.assignment && (
                <a
                  href={teaching.resources.assignment}
                  target="_blank"
                  class="text-link inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium badge-tech hover:border-accent-300 hover:text-accent-600 dark:hover:text-accent-400"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  Ödev
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center p-8 sm:p-10 card-highlight">
        <h2 class="font-display text-xl sm:text-2xl font-bold mb-3">
          AI ile daha etkili nasıl çalışılır öğrenmek ister misiniz?
        </h2>
        <p class="opacity-80 mb-6 max-w-xl mx-auto">
          Ekibiniz için AI-augmented geliştirme eğitimi, bireysel danışmanlık veya öğrenme stratejisi konusunda iletişime geçin.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/20 hover:bg-white/30 font-medium transition-colors backdrop-blur-sm"
        >
          İletişime Geç
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
import { TEACHINGS, PAST_TEACHINGS } from '../utils/constants';
---

<PageLayout
  title="Eğitimler — Umut Çakır"
  description="AI ile öğrenme stratejileri, AI-augmented yazılım geliştirme ve geçmiş teknik eğitim materyalleri."
>
  <section class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 mb-4">
          Eğitim & AI-Augmented Öğrenme
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-surface-50 mb-4">
          AI Çağında Öğrenme ve Geliştirme
        </h1>
        <p class="text-lg text-surface-600 dark:text-surface-400 leading-relaxed">
          AI artık her konuyu öğretebiliyor &#8212; asıl mesele <strong class="text-surface-800 dark:text-surface-200">neyi öğrenmen gerektiğini bilmek</strong>,
          <strong class="text-surface-800 dark:text-surface-200">kendi öğrenme yolculuğunu tasarlamak</strong> ve
          <strong class="text-surface-800 dark:text-surface-200">AI araçlarıyla 10x verimli olmak</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 border-t border-surface-200 dark:border-surface-700">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-3 text-center">
        Odak Alanlarım
      </h2>
      <p class="text-lg text-surface-600 dark:text-surface-400 max-w-2xl mx-auto text-center mb-10">
        AI ile daha hızlı öğren, daha etkili geliştir
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {TEACHINGS.map((teaching) => (
          <div class="relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-primary-300 dark:hover:border-primary-600 transition-all duration-300 hover:shadow-lg hover:shadow-primary-500/5 flex flex-col">
            <div class="mb-4">
              <div class="w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
              </div>
              <h3 class="text-xl font-bold text-surface-900 dark:text-surface-50">
                {teaching.title}
              </h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300">
                  {teaching.platform}
                </span>
              </div>
            </div>

            <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed mb-4">
              {teaching.description}
            </p>

            <div class="flex flex-wrap gap-2 mt-auto">
              {teaching.topics.map((topic: string) => (
                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 border border-surface-200 dark:border-surface-600">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 border-t border-surface-200 dark:border-surface-700">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-16">
      <div class="text-center mb-10">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-3">
          Geçmiş Eğitimler
        </h2>
        <p class="text-base text-surface-500 dark:text-surface-400 max-w-2xl mx-auto">
          2023'te çevrimiçi eğitim platformunda verdiğim teknik eğitimler ve materyalleri
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {PAST_TEACHINGS.map((teaching) => (
          <div class="p-6 rounded-2xl bg-surface-50 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700 flex flex-col">
            <h3 class="text-base font-semibold text-surface-900 dark:text-surface-50 mb-1">
              {teaching.title}
            </h3>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-surface-500 dark:text-surface-400">
                {teaching.platform}
              </span>
              <span class="text-surface-300 dark:text-surface-600">&middot;</span>
              <span class="text-xs text-surface-500 dark:text-surface-400">
                {teaching.period}
              </span>
            </div>
            <p class="text-sm text-surface-500 dark:text-surface-400 leading-relaxed mb-4">
              {teaching.description}
            </p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {teaching.resources.slides && (
                <a
                  href={teaching.resources.slides}
                  target="_blank"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-primary-900/30 dark:hover:text-primary-300 transition-colors border border-surface-200 dark:border-surface-600"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>
                  Sunum
                </a>
              )}
              {teaching.resources.assignment && (
                <a
                  href={teaching.resources.assignment}
                  target="_blank"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-primary-900/30 dark:hover:text-primary-300 transition-colors border border-surface-200 dark:border-surface-600"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  Ödev
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="relative p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-primary-50 to-primary-100/50 dark:from-primary-900/20 dark:to-primary-800/10 border border-primary-200 dark:border-primary-800/30 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-surface-900 dark:text-surface-50 mb-3">
          AI ile daha etkili nasıl çalışılır öğrenmek ister misiniz?
        </h2>
        <p class="text-surface-600 dark:text-surface-400 mb-6 max-w-xl mx-auto">
          Ekibiniz için AI-augmented geliştirme eğitimi, bireysel danışmanlık veya öğrenme stratejisi konusunda iletişime geçin.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors shadow-lg shadow-primary-500/20"
        >
          İletişime Geç
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

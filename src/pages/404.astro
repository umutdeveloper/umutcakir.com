---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa bulunamadı."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 sm:py-32 text-center">
    <div class="text-8xl font-bold text-surface-200 dark:text-surface-700 mb-4">404</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-surface-900 dark:text-surface-50 mb-4">
      Sayfa Bulunamadı
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-8">
      Aradığınız sayfa mevcut değil veya taşınmış olabilir.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-medium transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Ana Sayfaya Dön
    </a>
  </div>
</PageLayout>

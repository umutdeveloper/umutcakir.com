---
import PageLayout from './PageLayout.astro';
import { formatDate } from '../utils/format-date';
import { getReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  rawContent: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], rawContent } = Astro.props;
const readingTime = getReadingTime(rawContent);
---

<PageLayout title={title} description={description} image={heroImage} type="article" publishDate={pubDate} tags={tags}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 text-sm text-surface-400 mb-4">
        <time datetime={pubDate.toISOString()} class="font-mono text-xs">{formatDate(pubDate)}</time>
        {updatedDate && (
          <span>
            · Güncellendi: <time datetime={updatedDate.toISOString()} class="font-mono text-xs">{formatDate(updatedDate)}</time>
          </span>
        )}
        <span>· {readingTime}</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-surface-900 dark:text-[#EDEDEC] leading-tight mb-4" style="letter-spacing: -0.02em;">
        {title}
      </h1>
      <p class="text-lg text-surface-500 dark:text-surface-400">
        {description}
      </p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="badge-tech">
              {tag}
            </span>
          ))}
        </div>
      )}
      <div class="h-px w-full bg-gradient-to-r from-accent-400/40 via-accent-400/10 to-transparent mt-6"></div>
    </header>

    {heroImage && (
      <img
        src={heroImage}
        alt={title}
        class="w-full rounded-xl mb-10 shadow-lg"
        loading="eager"
      />
    )}

    <!-- Content -->
    <div class="prose prose-lg dark:prose-invert max-w-none
      prose-headings:scroll-mt-20
      prose-code:before:content-none prose-code:after:content-none
      prose-img:rounded-xl prose-img:shadow-lg
      prose-pre:font-mono">
      <slot />
    </div>

    <!-- Footer navigation -->
    <div class="mt-16 pt-8 border-t border-surface-200 dark:border-[rgba(255,255,255,0.06)]">
      <a href="/blog" class="text-link inline-flex items-center gap-2 text-accent-500 dark:text-accent-400 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Tüm Yazılar
      </a>
    </div>
  </article>
</PageLayout>

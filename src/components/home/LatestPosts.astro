---
import { getCollection } from 'astro:content';
import PostCard from '../../components/blog/PostCard.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{latestPosts.length > 0 && (
  <section class="py-16 sm:py-20 bg-surface-100/50 dark:bg-surface-800/30 border-t border-surface-200 dark:border-surface-700">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400">
          Son Yazılar
        </h2>
        <a href="/blog" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline">
          Tümünü gör →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id.replace(/\.mdx?$/, '')}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
)}

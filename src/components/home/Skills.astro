---
const skillGroups = [
  {
    label: 'Frontend',
    color: 'text-accent-400',
    items: ['Angular', 'TypeScript', 'Electron', 'RxJS', 'React', 'Tailwind CSS'],
  },
  {
    label: 'Backend & Infra',
    color: 'text-teal-400',
    items: ['Node.js', 'Express', 'MongoDB', 'Docker', 'AWS', 'gRPC'],
  },
  {
    label: 'AI & Workflow',
    color: 'text-coral-400',
    items: ['AI Pair Programming', 'Prompt Engineering', 'Agentic Patterns', 'AI Workflows'],
  },
];
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-start">
      <!-- Left: text -->
      <div class="lg:col-span-2 reveal">
        <span class="section-label">Tech Stack</span>
        <h2 class="section-title text-3xl sm:text-4xl mt-3 mb-4">
          Araçlar &<br />teknolojiler<span class="text-accent-400">.</span>
        </h2>
        <p class="section-desc text-sm">
          9 yılda üretim ortamında kullandığım, gerçek projelerde kanıtlanmış teknoloji seti.
        </p>
      </div>

      <!-- Right: widget card with skill groups -->
      <div class="lg:col-span-3 reveal reveal-delay-1">
        <div class="widget p-6 sm:p-8">
          <div class="space-y-6">
            {skillGroups.map((group) => (
              <div>
                <div class={`text-xs font-mono font-medium uppercase tracking-wider ${group.color} mb-3`}>
                  {group.label}
                </div>
                <div class="flex flex-wrap gap-2">
                  {group.items.map((skill) => (
                    <span class="px-3 py-1.5 text-sm font-mono rounded-lg bg-surface-100 dark:bg-white/[0.04] border border-surface-200 dark:border-white/[0.06] text-surface-600 dark:text-surface-400 hover:border-accent-400/40 dark:hover:border-accent-400/30 transition-colors cursor-default">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

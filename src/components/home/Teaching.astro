---
import { TEACHINGS } from '../../utils/constants';
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 reveal">
      <span class="section-label">Eğitim & Öğrenme</span>
      <h2 class="section-title text-3xl sm:text-4xl mt-3">
        AI ile öğren, geliştir<span class="text-accent-400">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {TEACHINGS.map((teaching, i) => (
        <div class={`widget p-6 group flex flex-col reveal reveal-delay-${i + 1}`}>
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block px-2 py-0.5 text-[0.625rem] font-mono font-medium rounded bg-teal-400/10 text-teal-400">
              {teaching.platform}
            </span>
          </div>

          <h3 class="font-display text-base font-bold text-surface-900 dark:text-white mb-2">
            {teaching.title}
          </h3>

          <p class="text-sm text-surface-500 dark:text-surface-500 leading-relaxed mb-4 line-clamp-3 flex-1">
            {teaching.description}
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            {teaching.topics.slice(0, 3).map((topic: string) => (
              <span class="px-2 py-0.5 text-[0.625rem] font-mono rounded bg-surface-100 dark:bg-white/[0.04] border border-surface-200 dark:border-white/[0.06] text-surface-500 dark:text-surface-500">
                {topic}
              </span>
            ))}
            {teaching.topics.length > 3 && (
              <span class="px-2 py-0.5 text-[0.625rem] font-mono rounded bg-surface-100 dark:bg-white/[0.04] border border-surface-200 dark:border-white/[0.06] text-surface-400">
                +{teaching.topics.length - 3}
              </span>
            )}
          </div>

          <a
            href="/egitimler"
            class="text-sm font-medium text-accent-400 hover:text-accent-300 transition-colors inline-flex items-center gap-1 mt-auto"
          >
            Detaylar
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

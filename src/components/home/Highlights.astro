---
const stats = [
  { value: '9+', label: 'Yıl', detail: 'Production deneyimi' },
  { value: '8', label: 'Migration', detail: 'Major Angular upgrade' },
  { value: '30+', label: 'Özellik', detail: 'Uçtan uca teslimat' },
  { value: '1', label: 'Startup', detail: 'Co-founder (0→1)' },
];

const capabilities = [
  { emoji: '⚡', label: 'AI-Augmented Dev', desc: 'AI ile 10x hızlandırılmış geliştirme süreci' },
  { emoji: '🏗️', label: 'Mimari Tasarım', desc: 'Modüler, ölçeklenebilir sistem mimarisi' },
  { emoji: '🔒', label: 'Güvenlik', desc: 'E2E encryption, OpenID Connect, HMAC' },
  { emoji: '🖥️', label: 'Cross-Platform', desc: 'Electron + Angular, tek codebase' },
  { emoji: '🎯', label: 'Performans', desc: 'Memory leak hunting, render optimizasyonu' },
  { emoji: '🔄', label: 'Migration', desc: 'Angular 13→21, legacy modernizasyon' },
];
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 reveal">
      <span class="section-label">Genel Bakış</span>
      <h2 class="section-title text-3xl sm:text-4xl mt-3">
        Rakamlar & yetkinlikler<span class="text-accent-400">.</span>
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Stats row — 4 metric widgets -->
      {stats.map((stat, i) => (
        <div class={`widget p-6 flex flex-col justify-between min-h-[140px] reveal reveal-delay-${i + 1}`}>
          <div class="text-4xl sm:text-5xl font-display font-bold text-surface-900 dark:text-white tracking-tight">
            {stat.value}
          </div>
          <div>
            <div class="text-sm font-semibold text-surface-700 dark:text-surface-300 mb-0.5">
              {stat.label}
            </div>
            <div class="text-xs text-surface-400 dark:text-surface-500">
              {stat.detail}
            </div>
          </div>
        </div>
      ))}

      <!-- Capabilities — 2-column inside the 4-col grid, spanning full width -->
      <div class="col-span-2 lg:col-span-4 grid grid-cols-2 lg:grid-cols-3 gap-4 mt-2">
        {capabilities.map((cap, i) => (
          <div class={`widget p-5 group reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="text-2xl mb-3">{cap.emoji}</div>
            <h3 class="text-sm font-semibold text-surface-900 dark:text-surface-200 mb-1 font-display">
              {cap.label}
            </h3>
            <p class="text-xs text-surface-500 dark:text-surface-500 leading-relaxed">
              {cap.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

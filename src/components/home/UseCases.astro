          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5">
            {uc.tags.map(tag => (
              <span class="px-2 py-0.5 text-xs rounded-full bg-surface-100 dark:bg-surface-700 text-surface-500 dark:text-surface-400">
                {tag}
              </span>
            ))}

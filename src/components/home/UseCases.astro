              <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-50">
                {uc.title}
              </h3>
              <p class="text-xs font-medium text-primary-600 dark:text-primary-400">
                {uc.subtitle}
              </p>
            </div>
          </div>

          <!-- Description -->
          <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed mb-4">
            {uc.description}
          </p>

          <!-- Evidence -->
          <ul class="space-y-2 mb-4">
            {uc.evidence.map(e => (
              <li class="flex items-start gap-2 text-sm text-surface-700 dark:text-surface-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1 text-primary-500"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>

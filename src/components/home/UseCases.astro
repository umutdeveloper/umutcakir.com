---
const useCases = [
  {
    title: 'Kompleks Özellik Geliştirme',
    subtitle: 'DB → State → UI → Deploy, bağımsız teslimat',
    description: 'Mesajlaşma, feed, anket gibi karmaşık modülleri uçtan uca tasarlayıp teslim ediyorum. 0→1 SaaS ürünü kurdum.',
    tags: ['Full-Stack', 'AI Pair Programming', '0→1 Product'],
  },
  {
    title: 'Migration & Modernizasyon',
    subtitle: '8 major Angular upgrade, sıfır downtime',
    description: 'Angular.js → Angular ve 8 major versiyon yükseltmesini production\'da sorunsuz tamamladım. AI ile impact analizi ve otomatik refactoring.',
    tags: ['Framework Migration', 'AI + Refactoring', 'Technical Debt'],
  },
  {
    title: 'Performans & Stabilite',
    subtitle: 'Memory leak hunter, render optimizer',
    description: 'RxJS, Blob URL, PDF kaynaklı memory leak\'leri tespit edip düzelttim. AI ile hızlı root cause analizi ve heap snapshot yorumlama.',
    tags: ['Memory Leaks', 'AI Diagnostics', 'Optimization'],
  },
  {
    title: 'Cross-Platform',
    subtitle: 'Electron + Angular, tek codebase',
    description: 'Masaüstü + web uygulamasını 3.5+ yıldır aynı kod tabanından geliştiriyorum. OPFS, clipboard API, browser kısıtlamaları deneyimi.',
    tags: ['Electron', 'Multi-Platform', 'Desktop App'],
  },
];
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 reveal">
      <span class="section-label">Fark Yarattığım Alanlar</span>
      <h2 class="section-title text-3xl sm:text-4xl mt-3">
        Kanıtlanmış çözümler<span class="text-accent-400">.</span>
      </h2>
    </div>

    <!-- Use case cards — 2-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {useCases.map((uc, i) => (
        <div class={`widget p-6 sm:p-7 group reveal reveal-delay-${(i % 2) + 1}`}>
          <h3 class="font-display text-lg font-bold text-surface-900 dark:text-white mb-1">
            {uc.title}
          </h3>
          <p class="text-xs font-mono text-accent-400 mb-3">
            {uc.subtitle}
          </p>
          <p class="text-sm text-surface-500 dark:text-surface-500 leading-relaxed mb-4">
            {uc.description}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {uc.tags.map((tag) => (
              <span class="px-2 py-0.5 text-[0.6875rem] font-mono rounded bg-surface-100 dark:bg-white/[0.04] border border-surface-200 dark:border-white/[0.06] text-surface-500 dark:text-surface-500">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

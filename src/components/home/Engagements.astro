---
const services = [
  {
    emoji: '✍️',
    title: 'Teknik Blog',
    description: 'AI-augmented geliştirme pratikleri, verimlilik stratejileri ve gerçek dünya deneyimleri.',
    cta: { label: 'Yazıları Oku', href: '/blog' },
  },
  {
    emoji: '📦',
    title: 'Dijital Ürünler',
    description: 'AI çağında öğrenme rehberleri, verimlilik araç setleri ve pratik kaynaklar.',
    cta: { label: 'Kaynaklara Göz At', href: '/egitimler' },
  },
  {
    emoji: '💡',
    title: 'Teknik Danışmanlık',
    description: 'AI stratejisi, mimari review, performans audit ve ekip verimliliği konularında danışmanlık.',
    cta: { label: 'İletişime Geç', href: '/contact' },
  },
];
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="mb-12 reveal">
      <span class="section-label">Hizmetler</span>
      <h2 class="section-title text-3xl sm:text-4xl mt-3">
        Size nasıl yardımcı olabilirim<span class="text-accent-400">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {services.map((svc, i) => (
        <div class={`widget p-6 group flex flex-col reveal reveal-delay-${i + 1}`}>
          <div class="text-2xl mb-4">{svc.emoji}</div>
          <h3 class="font-display text-base font-bold text-surface-900 dark:text-white mb-2">
            {svc.title}
          </h3>
          <p class="text-sm text-surface-500 dark:text-surface-500 leading-relaxed mb-4 flex-1">
            {svc.description}
          </p>
          <a
            href={svc.cta.href}
            class="text-sm font-medium text-accent-400 hover:text-accent-300 transition-colors inline-flex items-center gap-1 mt-auto"
          >
            {svc.cta.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

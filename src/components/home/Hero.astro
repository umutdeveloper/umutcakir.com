---
---

<section class="relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-32">
    <div class="max-w-3xl">
      <!-- Name -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-surface-900 dark:text-surface-50 mb-4 animate-fade-in-up opacity-0">
        Umut Çakır<span class="text-primary-500">.</span>
      </h1>

      <!-- Title -->
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-surface-600 dark:text-surface-400 mb-6 animate-fade-in-up opacity-0 delay-100">
        AI-Augmented Software Engineer
      </h2>

      <!-- Description -->
      <p class="text-base sm:text-lg text-surface-600 dark:text-surface-400 leading-relaxed mb-4 max-w-2xl animate-fade-in-up opacity-0 delay-200">
        9+ yıl mühendislik deneyimini AI ile birleştirerek daha hızlı, daha etkili ve daha stratejik ürünler inşa ediyorum.
        Öğrendiklerimi blog, eğitim ve danışmanlık ile paylaşıyorum.
      </p>

      <!-- Value prop -->
      <p class="text-sm text-surface-500 dark:text-surface-400 mb-8 max-w-2xl animate-fade-in-up opacity-0 delay-200">
        AI-augmented geliştirme · Enterprise güvenli iletişim platformu · Angular uzmanı · Performans mühendisliği
      </p>

      <!-- What I offer badges -->
      <div class="flex flex-wrap gap-2 mb-8 animate-fade-in-up opacity-0 delay-300">
        {[
          { label: 'AI-Augmented Blog', icon: '✍️' },
          { label: 'Danışmanlık', icon: '🎯' },
          { label: 'Eğitim & Kaynaklar', icon: '📦' },
        ].map(item => (
          <span class="px-3 py-1.5 text-sm font-medium rounded-full border border-primary-200 dark:border-primary-800 text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/20">
            <span class="mr-1">{item.icon}</span>{item.label}
          </span>
        ))}
      </div>

      <!-- Tech badges -->
      <div class="flex flex-wrap gap-2 mb-8 animate-fade-in-up opacity-0 delay-300">
        {['Angular', 'TypeScript', 'Electron', 'AI Workflows', 'Node.js'].map(tech => (
          <span class="px-3 py-1.5 text-sm font-medium rounded-full border border-surface-200 dark:border-surface-700 text-surface-700 dark:text-surface-300 bg-surface-100/50 dark:bg-surface-800/50">
            {tech}
          </span>
        ))}
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-wrap items-center gap-4 animate-fade-in-up opacity-0 delay-400">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-medium transition-colors shadow-lg shadow-primary-600/20"
        >
          Blog Yazıları
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 font-medium transition-colors"
        >
          Hakkımda
        </a>
        <a
          href="https://linkedin.com/in/umuttcakir"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 font-medium transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  <!-- Background gradient decoration -->
  <div class="absolute top-0 right-0 -z-10 w-96 h-96 bg-primary-500/5 dark:bg-primary-400/5 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-0 -z-10 w-72 h-72 bg-cyan-500/5 dark:bg-cyan-400/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
</section>

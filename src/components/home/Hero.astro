---
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Ambient glow circles -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute top-[-20%] left-[50%] -translate-x-1/2 w-[800px] h-[500px] bg-[radial-gradient(ellipse_50%_50%_at_50%_50%,rgba(232,168,73,0.06),transparent)]"></div>
    <div class="absolute bottom-[-10%] right-[-5%] w-[400px] h-[400px] bg-[radial-gradient(circle,rgba(45,212,168,0.04),transparent)]"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center py-16">
    <!-- Name — massive, centered, with avatar -->
    <div class="flex items-center justify-center gap-5 sm:gap-6 mb-6 animate-fade-in-up opacity-0">
      <img src="/assets/avatar.png" alt="Umut Çakır" class="w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24 rounded-full ring-2 ring-accent-400/30 object-cover" />
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl font-bold text-surface-900 dark:text-[#EDEDEC] tracking-tight" style="letter-spacing: -0.04em; line-height: 0.95;">
        Umut Çakır<span class="text-accent-400">.</span>
      </h1>
    </div>

    <!-- One liner — the compound value prop -->
    <p class="text-lg sm:text-xl lg:text-2xl text-surface-500 dark:text-[#71717A] max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in-up opacity-0 delay-100">
      9+ yıl mühendislik deneyimini <span class="text-accent-400 font-medium">AI</span> ile birleştirerek
      karmaşık ürünler inşa eden, ekipleri hızlandıran Senior Software Engineer.
    </p>

    <!-- CTA row -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16 animate-fade-in-up opacity-0 delay-200">
      <a href="/blog" class="btn-primary">
        Blog Yazıları
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/about" class="btn-secondary">Hakkımda</a>
      <a href="https://linkedin.com/in/umuttcakir" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        LinkedIn
      </a>
    </div>

    <!-- Terminal showcase — the "product demo" widget -->
    <div class="max-w-xl mx-auto animate-fade-in-up opacity-0 delay-300">
      <div class="terminal-window text-left shadow-2xl shadow-black/20 dark:shadow-black/50">
        <div class="terminal-header">
          <div class="terminal-dot" style="background: #ff5f57;"></div>
          <div class="terminal-dot" style="background: #ffbd2e;"></div>
          <div class="terminal-dot" style="background: #28c840;"></div>
          <span class="ml-3 text-xs text-white/20 font-mono">umutcakir.com — zsh</span>
        </div>
        <div class="terminal-body">
          <div><span class="cmd">$</span> cat profile.json</div>
          <div class="mt-2 text-white/50">{`{`}</div>
          <div class="pl-4"><span class="text-teal-400">"role"</span>: <span class="text-accent-300">"Senior Software Engineer"</span>,</div>
          <div class="pl-4"><span class="text-teal-400">"location"</span>: <span class="text-accent-300">"İstanbul, Türkiye"</span>,</div>
          <div class="pl-4"><span class="text-teal-400">"stack"</span>: [<span class="text-accent-300">"Angular"</span>, <span class="text-accent-300">"TypeScript"</span>, <span class="text-accent-300">"Electron"</span>],</div>
          <div class="pl-4"><span class="text-teal-400">"ai"</span>: <span class="text-accent-300">"augmented-workflows"</span>,</div>
          <div class="pl-4"><span class="text-teal-400">"experience"</span>: <span class="text-accent-300">"9+ years"</span></div>
          <div class="text-white/50">{`}`}</div>
          <div class="mt-3"><span class="cmd">$</span> status<span class="terminal-cursor"></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

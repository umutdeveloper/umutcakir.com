---
import { EXPERIENCES } from '../../utils/constants';
---

<section class="py-16 sm:py-20 border-t border-surface-200 dark:border-surface-700">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-500 dark:text-surface-400 mb-10 text-center">
      Deneyim
    </h2>
    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-4 sm:left-6 top-0 bottom-0 w-px bg-surface-200 dark:bg-surface-700"></div>

        {EXPERIENCES.map((exp, i) => (
          <div class="relative pl-12 sm:pl-16 pb-12 last:pb-0 group">
            <!-- Timeline dot -->
            <div class="absolute left-2.5 sm:left-4.5 top-1.5 w-3 h-3 rounded-full border-2 border-primary-500 bg-surface-50 dark:bg-surface-900 group-hover:bg-primary-500 transition-colors"></div>

            <!-- Period -->
            <span class="text-xs font-medium text-primary-600 dark:text-primary-400 uppercase tracking-wide">
              {exp.period}
            </span>

            <!-- Company & Role -->
            <h3 class="text-lg font-bold text-surface-900 dark:text-surface-50 mt-1">
              {exp.company}
            </h3>
            <p class="text-sm font-medium text-surface-600 dark:text-surface-400 mb-1">
              {exp.role} · {exp.location}
            </p>

            <!-- Description -->
            <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed mt-2">
              {exp.description}
            </p>

            <!-- Highlights -->
            <div class="flex flex-wrap gap-2 mt-3">
              {exp.highlights.map(h => (
                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-400 border border-surface-200 dark:border-surface-700">
                  {h}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

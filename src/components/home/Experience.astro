---
import { EXPERIENCES } from '../../utils/constants';
---

<section class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-start">
      <!-- Left: text -->
      <div class="lg:col-span-2 reveal">
        <span class="section-label">Kariyer</span>
        <h2 class="section-title text-3xl sm:text-4xl mt-3 mb-4">
          Deneyim<span class="text-accent-400">.</span>
        </h2>
        <p class="section-desc text-sm">
          Startup'tan enterprise'a, 4 farklı şirkette üretilen değer.
        </p>
      </div>

      <!-- Right: timeline in a widget -->
      <div class="lg:col-span-3 reveal reveal-delay-1">
        <div class="widget p-6 sm:p-8">
          <div class="space-y-0">
            {EXPERIENCES.map((exp, i) => (
              <div class={`relative pl-6 pb-8 last:pb-0 border-l ${i === 0 ? 'border-accent-400/50' : 'border-surface-200 dark:border-white/[0.06]'}`}>
                <!-- Dot -->
                <div class={`absolute -left-[5px] top-1 w-2.5 h-2.5 rounded-full ${i === 0 ? 'bg-accent-400' : 'bg-surface-300 dark:bg-surface-600'}`}></div>

                <!-- Period -->
                <div class="text-[0.6875rem] font-mono text-surface-400 dark:text-surface-500 mb-1">
                  {exp.period}
                </div>

                <!-- Company & Role -->
                <h3 class="font-display text-base font-bold text-surface-900 dark:text-white">
                  {exp.company}
                </h3>
                <p class="text-sm text-surface-500 dark:text-surface-500 mb-2">
                  {exp.role} · {exp.location}
                </p>

                <!-- Description -->
                <p class="text-sm text-surface-500 dark:text-surface-500 leading-relaxed mb-3">
                  {exp.description}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5">
                  {exp.highlights.map((h) => (
                    <span class="px-2 py-0.5 text-[0.625rem] font-mono rounded bg-surface-100 dark:bg-white/[0.04] border border-surface-200 dark:border-white/[0.06] text-surface-500 dark:text-surface-500">
                      {h}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

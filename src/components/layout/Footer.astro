---
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-200 dark:border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- CTA -->
    <div class="py-20 text-center">
      <h3 class="font-display text-3xl sm:text-4xl font-bold text-surface-900 dark:text-white mb-4 tracking-tight" style="letter-spacing: -0.03em;">
        Birlikte çalışalım<span class="text-accent-400">.</span>
      </h3>
      <p class="text-surface-500 dark:text-surface-500 mb-8 max-w-md mx-auto">
        Yeni projeler, teknik danışmanlık veya sadece merhaba demek için.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="mailto:umutcakirbm@gmail.com" class="btn-primary">
          E-posta Gönder
        </a>
        <a href="https://linkedin.com/in/umuttcakir" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-surface-200 dark:border-white/[0.06] py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-surface-400 dark:text-surface-500">
      <div class="flex items-center gap-2">
        <span class="font-display font-bold text-surface-600 dark:text-surface-300">UC<span class="text-accent-400">.</span></span>
        <span>© {year} Umut Çakır</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/umutcakir" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors">GitHub</a>
        <a href="https://linkedin.com/in/umuttcakir" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors">LinkedIn</a>
        <a href="mailto:umutcakirbm@gmail.com" class="hover:text-accent-400 transition-colors">E-posta</a>
      </div>
    </div>
  </div>
</footer>

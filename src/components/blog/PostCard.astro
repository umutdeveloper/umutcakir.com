---
import { formatDate } from '../../utils/format-date';
import { getReadingTime } from '../../utils/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;
---

<a href={`/blog/${slug}`} class="block group">
  <article class="card-blueprint p-6 h-full">
    <!-- Date -->
    <time datetime={pubDate.toISOString()} class="section-label text-[0.625rem]">
      {formatDate(pubDate)}
    </time>

    <!-- Title -->
    <h3 class="font-display text-lg font-bold text-surface-900 dark:text-[#EDEDEC] mt-2 mb-2 group-hover:text-accent-500 dark:group-hover:text-accent-400 transition-colors line-clamp-2">
      {title}
    </h3>

    <!-- Accent line -->
    <div class="h-px w-12 bg-accent-400/40 mb-3 group-hover:w-full transition-all duration-500"></div>

    <!-- Description -->
    <p class="text-sm text-surface-500 dark:text-surface-400 leading-relaxed line-clamp-3 mb-4">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map(tag => (
          <span class="badge-tech">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</a>

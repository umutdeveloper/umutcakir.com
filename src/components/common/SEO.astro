---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  tags?: string[];
}

const {
  title,
  description,
  image = '/og-default.png',
  canonicalURL = Astro.url.href,
  type = 'website',
  publishDate,
  tags = [],
} = Astro.props;

const siteTitle = title === 'Umut Çakır' ? title : `${title} | Umut Çakır`;
const imageURL = new URL(image, Astro.site).href;
---

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content="Umut Çakır" />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="Umut Çakır" />
<meta property="og:locale" content="tr_TR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

{publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}

<!-- JSON-LD Structured Data -->
{type === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Umut Çakır",
    "url": "https://umutcakir.com",
    "author": {
      "@type": "Person",
      "name": "Umut Çakır",
      "jobTitle": "Senior Software Engineer",
      "url": "https://umutcakir.com",
      "sameAs": [
        "https://linkedin.com/in/umuttcakir",
        "https://github.com/umutcakir"
      ]
    }
  })} />
)}

{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": imageURL,
    "author": {
      "@type": "Person",
      "name": "Umut Çakır",
      "url": "https://umutcakir.com"
    },
    "datePublished": publishDate?.toISOString(),
    "publisher": {
      "@type": "Person",
      "name": "Umut Çakır"
    }
  })} />
)}
